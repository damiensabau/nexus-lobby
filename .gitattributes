# Fins de ligne normalisées (LF dans le dépôt, CRLF à l'extraction sous Windows pour les fichiers texte).
* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.sln     text eol=crlf
*.ps1     text eol=crlf
*.iss     text eol=crlf
*.md      text
*.json    text
*.yml     text

*.png     binary
*.ico     binary
