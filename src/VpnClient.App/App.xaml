<Application x:Class="VpnClient.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:VpnClient.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Resources/WorldMap.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Palette « gaming » : bleu nuit + néon cyan / violet -->
            <Color x:Key="BgDeepColor">#070C18</Color>
            <SolidColorBrush x:Key="BgDeep" Color="{StaticResource BgDeepColor}" />
            <SolidColorBrush x:Key="Panel" Color="#0D1424" />
            <SolidColorBrush x:Key="PanelAlt" Color="#121B2F" />
            <SolidColorBrush x:Key="PanelHover" Color="#18233B" />
            <SolidColorBrush x:Key="Stroke" Color="#1F2B45" />
            <SolidColorBrush x:Key="TextMuted" Color="#8B97AD" />
            <SolidColorBrush x:Key="TextDim" Color="#5B6782" />
            <SolidColorBrush x:Key="Neon" Color="#38BDF8" />
            <SolidColorBrush x:Key="Green" Color="#22C55E" />
            <SolidColorBrush x:Key="Red" Color="#EF4444" />
            <SolidColorBrush x:Key="Amber" Color="#F59E0B" />
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6366F1" Offset="0" />
                <GradientStop Color="#3B82F6" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EF4444" Offset="0" />
                <GradientStop Color="#B91C1C" Offset="1" />
            </LinearGradientBrush>

            <conv:FlagBrushConverter x:Key="FlagBrush" />

            <!-- Badge drapeau : Width/Height à fixer à l'usage, le code pays dans Tag. -->
            <Style x:Key="Flag" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#40FFFFFF" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource FlagBrush}}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.45" Color="Black" />
                    </Setter.Value>
                </Setter>
            </Style>

            <conv:StateToBrushConverter x:Key="StateToBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
